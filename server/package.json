{
  "name": "jev-mcp-worker",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "dependencies": {
    "@jkudish/jev-agent-tools": "^0.2.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "wrangler": "^4"
  },
  "scripts": {
    "vendor": "sh build-vendor.sh",
    "fingerprint": "node scripts/gen-rules-fingerprint.mjs",
    "pretest": "npm run fingerprint",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dev": "npm run vendor && npm run fingerprint && wrangler dev",
    "deploy": "npm run vendor && npm run fingerprint && wrangler deploy --keep-vars"
